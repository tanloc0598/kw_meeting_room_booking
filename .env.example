# Optional. `docker compose up` works without a .env file — every value below is the default.
# Copy to .env only to override: cp .env.example .env

# --- App ---
# Host port of the API (container always listens on 8080)
APP_PORT=8082
# HS256 signing key, at least 32 bytes. MUST be changed for any real deployment.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# --- Database ---
# Postgres only applies these when its volume is first created; after changing them run `docker compose down -v`.
DB_NAME=meeting_room_booking
DB_USER=app
DB_PASSWORD=app

# --- Booking rules (ISO-8601 durations: PT5M = 5 minutes, P90D = 90 days) ---
# BR4: minimum booking length
BOOKING_MIN_DURATION=PT5M
# BR4: length must be a multiple of this step
BOOKING_DURATION_STEP=PT5M
# BR4: company time zone — a booking must not cross midnight in this zone
BOOKING_ZONE=Asia/Ho_Chi_Minh
# BR5: how far ahead a booking may start; P0D = no limit
BOOKING_MAX_ADVANCE=P90D
